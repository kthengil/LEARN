#!/usr/bin/env python3
"""Every few seconds, checks whether each lab machine accepts SSH and whether its main service port is open,
and writes /run/lab/status.json for the web UI."""
import json, os, socket, time, yaml

lab = yaml.safe_load(open('/etc/lab/lab.yaml'))

def is_open(host, port):
    try:
        with socket.create_connection((host, port), timeout=1): return True
    except OSError:
        return False

while True:
    status = {}
    for m in lab['machines']:
        if m.get('local'):
            status[m['name']] = {'reachable': True, 'service': None}; continue
        host = m.get('host', m['name'])
        svc = m.get('service')
        status[m['name']] = {
            'reachable': is_open(host, m.get('port', 22)),
            'service': is_open(host, svc['port']) if svc else None,
        }
    tmp = '/run/lab/status.json.tmp'
    json.dump({'updated': int(time.time()), 'machines': status}, open(tmp, 'w'))
    os.replace(tmp, '/run/lab/status.json')
    time.sleep(3)
