# Lab settings. Change LAB_PORT if something else on your machine already uses it, then run the readiness check
# again (./check.sh or check.ps1): it validates the value and applies it to .env. Then restart with:
# docker compose up -d
# Port must be a number from 1024 to 65535.

# Port of the lab: http://localhost:<LAB_PORT>. The lessons show the default, 28207; use your value instead.
LAB_PORT=28207
