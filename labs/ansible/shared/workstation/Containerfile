# Reusable lab workstation: the browser entry point and SSH jump host of one lab.
# Built per lab with two contexts (see lab-platform/README.md):
#   context            = this folder (the generic platform)
#   additional context = "lab": the lab's own folder, with lab.yaml and a workstation/ folder
FROM docker.io/library/alpine:3.22

RUN apk add --no-cache bash tini ttyd nginx openssh-client openssh-keygen python3 py3-yaml su-exec \
      curl less vim nano ncurses \
 && adduser -D -s /bin/bash -h /home/lab lab \
 && rm -f /etc/nginx/http.d/default.conf

COPY nginx.conf /etc/nginx/http.d/lab.conf
COPY ui/ /usr/share/lab-ui/
COPY bin/ /usr/local/bin/
RUN chmod 755 /usr/local/bin/*

# Lab-specific layer: the manifest, plus optional extras (setup.sh installs extra tools, motd greets the local shell).
COPY --from=lab lab.yaml /etc/lab/lab.yaml
COPY --from=lab workstation/ /opt/lab/
RUN if [ -f /opt/lab/setup.sh ]; then sh /opt/lab/setup.sh; fi \
 && if [ -f /opt/lab/motd ]; then cp /opt/lab/motd /etc/motd; fi \
 && lab-render --check

EXPOSE 8080
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/lab-entrypoint"]
